{
  "root": true,
  "env": {
    "browser": true,
    "es2024": true,
    "node": true
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    ".git",
    "public",
    "functions/dist",
    "chrome-extension",
    "**/*.ts",
    "**/*.tsx",
    "**/*.d.ts"
  ],
  "parserOptions": {
    "ecmaVersion": 2024,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "extends": ["eslint:recommended"],
  "rules": {
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "no-unused-vars": "off"
  }
}
