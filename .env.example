# Client URL for CORS
# Comma-separated list of allowed origins
CLIENT_URL=http://localhost:5173

# LLM API Configuration
# For local development you can keep a VITE-prefixed key which Vite will expose to the dev client.
# Do NOT set a VITE-prefixed key in production. Instead set the server-only key below so it is NOT baked
# into the client bundle. In production set `LLM_API_KEY` in your host/secret manager and do NOT include
# it in the client build environment.
VITE_LLM_API_KEY=your_api_key_here
VITE_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
VITE_LLM_MODEL=gemini-flash-latest

# Server-side LLM key (use this for production; do NOT prefix with VITE_)
LLM_API_KEY=

# Pollinations API — powers image generation on the Shorts page.
# Get a key at https://enter.pollinations.ai/keys. Two key types exist:
#   sk_...  secret key, full account access — SERVER ONLY, never ship to a browser
#   pk_...  publishable key, safe to expose in a client
#
# Preferred: users add their own key in Settings → API (stored in their browser only).
# This server-side key is the fallback used by /api/pollinations/image when the
# client has no key of its own. It is never sent to the browser.
POLLINATIONS_API_KEY=

# Local development convenience ONLY. Vite bakes VITE_-prefixed variables into the
# public JS bundle, so never put an sk_ secret key here in a real deployment.
# VITE_POLLINATIONS_API_KEY=
